rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "dim.yazovaliyskii@gmail.com";
    }
    function validId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$');
    }

    // Public: which slots are taken (no personal data). Clients may only create.
    match /barber_slots/{id} {
      allow read: if true;
      allow create: if validId(id)
        && request.resource.data.keys().hasOnly(['at']);
      allow delete: if isAdmin();
    }

    // Private: customer name + phone. Anyone can create; only admin reads/deletes.
    match /barber_bookings/{id} {
      allow create: if validId(id)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30;
      allow read, delete: if isAdmin();
    }
  }
}
